# Local: copy to .env.local; Node.js 24.15+; no credentials needed for synthetic demo.
APP_ORIGIN=http://localhost:3040
SQLITE_PATH=.data/ascent.sqlite
NEXT_TELEMETRY_DISABLED=1

# Production requires a non-superuser/non-BYPASSRLS app identity and PostgreSQL/PostGIS.
# DATABASE_URL=postgresql://ascent_app:REPLACE@host:5432/ascent
# MIGRATION_DATABASE_URL=postgresql://migration_identity:REPLACE@host:5432/ascent
# PGSSL=require
# APP_ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
# CRON_SECRET=LONG_RANDOM_SECRET
# TRUST_PROXY=true
# PG_POOL_MAX=2
# Vercel Hobby setup: docs/vercel-hobby.md. Check configuration with npm run check:deploy.

# Groq-first optional synthesis. Evidence assistance needs no key or inference budget.
# Never prefix provider credentials with NEXT_PUBLIC_.
# GROQ_API_KEY=server_only
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REASONING=openai/gpt-oss-120b
# Published estimates, USD per million tokens; replace with contracted rates when different.
GROQ_FAST_INPUT_USD_PER_MILLION=0.075
GROQ_FAST_OUTPUT_USD_PER_MILLION=0.30
GROQ_REASONING_INPUT_USD_PER_MILLION=0.15
GROQ_REASONING_OUTPUT_USD_PER_MILLION=0.60
# External inference requires positive operator-approved per-question, daily and monthly caps.
# AI_REQUEST_BUDGET_USD=
# AI_DAILY_BUDGET_USD=
# AI_MONTHLY_BUDGET_USD=
AI_MAX_OUTPUT_TOKENS=2200
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=1
# Optional secondary: deliberate request only, never automatic cost escalation.
# AI_ALLOW_OPENAI_SECONDARY=approved
# OPENAI_API_KEY=server_only
# OPENAI_MODEL=operator_selected_model
# AI_DATA_SHARING=approved
# Known client/contact values are redacted by default; never assume that removes arbitrary free-text PII.
# AI_PII_SHARING=approved
# Cost estimates: set rates matching the contracted model; blank means not configured.
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# ZDR must be enabled by an authorized provider-account administrator first.
# These flags attest the operator's review; the app cannot verify provider settings.
AI_INFLIGHT_DEDUP=true
AI_REQUIRE_ZDR=false
# GROQ_ZDR_ATTESTED=approved
# GROQ_ZDR_REVIEWED_AT=ISO_TIMESTAMP
# OPENAI_ZDR_ATTESTED=approved
# OPENAI_ZDR_REVIEWED_AT=ISO_TIMESTAMP

# National property provider. All requests are explicit; no key is needed for labeled fixtures.
# RENTCAST_API_KEY=server_only
RENTCAST_TIMEOUT_MS=8000
PROPERTY_PROVIDER_ENABLED=false
PROPERTY_PROVIDER_MONTHLY_REQUEST_LIMIT=50
PROPERTY_PROVIDER_TENANT_MONTHLY_REQUEST_LIMIT=20
PROPERTY_PROVIDER_USER_MONTHLY_REQUEST_LIMIT=10
PROPERTY_PROVIDER_MAX_CONCURRENCY=2
PROPERTY_PROVIDER_BUDGET_WARNING_PERCENT=85
# Required positive operator-approved reserve and monthly cap; no tariff is assumed.
# Reserves round up to whole cents. These are conservative application bounds, not invoices.
# PROPERTY_PROVIDER_MAX_COST_PER_REQUEST_USD=
# PROPERTY_PROVIDER_MONTHLY_BUDGET_USD=
# A separately reviewed policy plus a tenant provider grant is required for live access.
# Use actual contract references/dates, not the placeholders below. No API key belongs in this JSON.
# PROPERTY_PROVIDER_POLICY_JSON={"providerId":"rentcast","version":"YOUR_REVIEW_VERSION","reviewedBy":"QUALIFIED_OPERATOR","reviewedAt":"CURRENT_ISO_TIMESTAMP","expiresAt":"FUTURE_ISO_TIMESTAMP","licenseReference":"YOUR_CONTRACT_REFERENCE","termsUrl":"https://www.rentcast.io/terms-api","allowedUses":["research","valuation","market","export"],"retentionHours":24,"cacheTtlMinutes":60,"requiresProfessionalVerification":false}
# Live evaluation is disabled unless expressly enabled and given --live --max-usd=N.
# AI_EVAL_ALLOW_LIVE=approved

# Stripe: no final prices are built in. Set approved recurring Stripe Price IDs.
# STRIPE_SECRET_KEY=server_only
# STRIPE_WEBHOOK_SECRET=server_only
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# PLAN_PRO_PRICE_LABEL=Your approved price label
# PLAN_TEAM_PRICE_LABEL=Your approved price label
# PLAN_ENTERPRISE_PRICE_LABEL=Contract terms
# All allowances can change independently. Free deterministic CMA is always unlimited.
PLAN_FREE_SEATS=1
PLAN_FREE_AI_REQUESTS=20
PLAN_FREE_FABRIC_QUERIES=200
PLAN_PRO_SEATS=1
PLAN_PRO_AI_REQUESTS=200
PLAN_PRO_FABRIC_QUERIES=2000
PLAN_TEAM_SEATS=10
PLAN_TEAM_AI_REQUESTS=1000
PLAN_TEAM_FABRIC_QUERIES=10000
PLAN_ENTERPRISE_SEATS=50
PLAN_ENTERPRISE_AI_REQUESTS=5000
PLAN_ENTERPRISE_FABRIC_QUERIES=50000

# Trusted operator review credentials. Never expose NEXT_PUBLIC secrets.
# VERIFICATION_REVIEW_SECRET=RANDOM_AT_LEAST_32_CHARACTERS
# DATA_GRANT_REVIEW_SECRET=DIFFERENT_RANDOM_AT_LEAST_32_CHARACTERS
# DOMAIN_RULE_REVIEW_SECRET=DIFFERENT_RANDOM_AT_LEAST_32_CHARACTERS
# TRUST_REVIEW_SECRET=DIFFERENT_RANDOM_AT_LEAST_32_CHARACTERS

# National fabric: synthetic DMV/Austin is the default. Live ingestion stays disabled.
FABRIC_LIVE_ENABLED=false
FABRIC_SCHEDULED_SYNC=false
# FABRIC_PROVIDER_URL=https://authorized-provider.example/odata/Property
# FABRIC_ALLOWED_HOSTS=authorized-provider.example
# FABRIC_PROVIDER_TOKEN=server_only_contract_token
# FABRIC_SOURCE_JSON={"id":"contract-source","providerId":"provider","label":"Contracted source","kind":"licensed","adapter":"reso","regionIds":["dmv"],"observedAt":"2026-10-15T12:00:00.000Z","expectedUpdateHours":24,"license":{"label":"Contract reference","allowedUses":["research","valuation","market"],"exportAllowed":false,"retentionDays":30},"documentationUrl":"https://authorized-provider.example/docs"}

# Valuation release switch. "disabled" keeps calculation available but blocks approval of any CMA.
# ASCENT_VALUATION_RELEASE=enabled
# ASCENT_VALUATION_RELEASE_REASON=Short operator note shown to users while paused

# Browser tests can select an installed Chrome-family executable; no browser download needed.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
