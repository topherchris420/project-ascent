{
  "name": "project-ascent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3040",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3040",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "audit:a11y": "node scripts/a11y-scan.mjs",
    "evaluate:domain": "tsx scripts/evaluate-domain.ts",
    "evaluate:ai": "tsx scripts/evaluate-ai.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.57.0",
    "zod": "4.6.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  }
}
