{
  "name": "project-ascent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3040",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3040",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "verify:postgres": "node --env-file-if-exists=.env.local --import tsx scripts/verify-postgres.ts",
    "check:deploy": "node --env-file-if-exists=.env.local --import tsx scripts/check-deployment.ts",
    "verify:hobby-setup": "node scripts/verify-hobby-setup.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "audit:a11y": "node scripts/a11y-scan.mjs",
    "evaluate:domain": "tsx scripts/evaluate-domain.ts",
    "evaluate:ai": "tsx scripts/evaluate-ai.ts",
    "validate:valuation": "tsx scripts/validate-valuation.ts",
    "replicate": "tsx scripts/replicate.ts",
    "replication:sign": "tsx scripts/replication/sign-record.ts",
    "usability:register": "tsx scripts/usability/register.ts",
    "usability:analyze": "tsx scripts/usability/analyze.ts",
    "usability:answer-key": "tsx scripts/usability/answer-key.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.ts\""
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
